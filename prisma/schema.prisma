generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String        @id @default(uuid())
  phoneNumber PhoneNumber[]
  emails      Email[]
  addresses   Address[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PhoneNumber {
  id        String   @id @default(uuid())
  number    String
  priority  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Email {
  id        String   @id @default(uuid())
  mail      String
  priority  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Address {
  id        String   @id @default(uuid())
  address   String
  priority  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique
  phoneNumber String     @unique
  fullName    String
  email       String?
  hash        String
  role        Role       @default(STAFF)
  customers   Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
}

enum Role {
  ADMIN
  DEV
  STAFF
}

model Message {
  id          String   @id @default(uuid())
  from        String
  phoneNumber String
  location    String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id          String           @id @default(uuid())
  fullName    String
  phoneNumber String           @unique()
  location    String
  services    ServiceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([fullName])
}

enum CustomerType {
  CLIENT
  SUPPLIER
}

model ServiceSession {
  id         String        @id @default(uuid())
  service    String
  price      Int           @default(0)
  paid       Int           @default(0)
  status     ServiceStatus
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  customer   Customer?     @relation(fields: [customerId], references: [id])
  customerId String?
}

enum ServiceStatus {
  PENDING
  SERVING
  PAYING
  COMPLETED
  IDLE
}

