generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String        @id @default(uuid())
  phoneNumber PhoneNumber[]
  emails      Email[]
  addresses   Address[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PhoneNumber {
  id        String   @id @default(uuid())
  number    String
  priority   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Email {
  id        String   @id @default(uuid())
  mail      String
  priority   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model Address {
  id        String   @id @default(uuid())
  address   String
  priority   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
}

model User {
  id          String  @id @default(uuid())
  username    String  @unique
  phoneNumber String  @unique
  fullName    String
  email       String?
  hash        String
  role        Role    @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  DEV
  STAFF
}

